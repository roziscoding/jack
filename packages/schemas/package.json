{
  "name": "@jack/schemas",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./radarr/types": "./src/generated/radarr/types.gen.ts",
    "./sonarr/types": "./src/generated/sonarr/types.gen.ts"
  },
  "module": "src/index.ts",
  "scripts": {
    "fetch-specs": "curl -sSL -o radarr.openapi.json https://raw.githubusercontent.com/Radarr/Radarr/master/src/Radarr.Api.V3/openapi.json && curl -sSL -o sonarr.openapi.json https://raw.githubusercontent.com/Sonarr/Sonarr/main/src/Sonarr.Api.V3/openapi.json",
    "generate": "openapi-ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/bun": "latest"
  }
}
