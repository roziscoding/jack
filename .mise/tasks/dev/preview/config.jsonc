// <<< preview config file >>>
// dev:preview:clean deletes apps/backend/config.jsonc only when its first line
// is the marker above, so a config you wrote yourself is never removed.
{
  // Template for `mise run dev:preview`. Copied to apps/backend/config.jsonc
  // when that file doesn't exist or still starts with the marker above; a
  // config without the marker is never overwritten. No servers, so nothing needs Radarr or Sonarr to be running.
  //
  // Keep "version" current: a config without it gets migrated on boot, and the
  // rewrite drops these comments, marker included.
  "version": 2,
  "jack": {
    "internalUrl": "http://jack:5225"
  },

  // Inside the container. /tmp is writable by the image's user without a mount.
  "downloads": {
    "completedPath": "/tmp/jack-preview/completed"
  },

  "servers": [],

  // Sample peers that never connect (.invalid never resolves), so they show as
  // offline. db:seed fills the catalog cache for them, which the Peer Catalog
  // keeps showing while a peer is unreachable. The names match the peers in
  // the seeded downloads.
  "peers": [
    { "name": "Alice", "url": "http://alice.invalid:5225", "apiKey": "preview-peer-key" },
    { "name": "Bob", "url": "http://bob.invalid:5225", "apiKey": "preview-peer-key" },
    { "name": "Carol", "url": "http://carol.invalid:5225", "apiKey": "preview-peer-key" }
  ]
}
